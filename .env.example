# ── NUMU MCP server configuration ──────────────────────────────────────────
# Copy to `.env` and fill in. All values are read from the environment;
# nothing is hard-coded in the source.

# Origin of the merchant's store. The subdomain matters — it identifies the
# tenant. Do NOT include the /api/v1 path; it is added automatically.
#   Production example:  https://mystore.numueg.app
#   Local API example:   http://mystore.localhost:8000
NUMU_MCP_BASE_URL=https://mystore.numueg.app

# The store's UUID. Every operation targets this single store.
NUMU_MCP_STORE_ID=00000000-0000-0000-0000-000000000000

# A NUMU Personal Access Token (starts with "numu_pat_"). Create one in the
# merchant dashboard, or via:
#   POST /api/v1/stores/{store_id}/access-tokens   { "name": "Claude MCP" }
NUMU_MCP_ACCESS_TOKEN=numu_pat_replace_me

# ── Transport ───────────────────────────────────────────────────────────────
# "stdio" for local clients like Claude Desktop (default), or "http" for a
# remote/streamable-HTTP server.
NUMU_MCP_TRANSPORT=stdio
# Only used when transport=http:
NUMU_MCP_HOST=127.0.0.1
NUMU_MCP_PORT=8765

# ── HTTP behaviour (optional) ────────────────────────────────────────────────
NUMU_MCP_TIMEOUT=30
# Set to false ONLY for local dev against a self-signed cert.
NUMU_MCP_VERIFY_SSL=true
NUMU_MCP_LOG_LEVEL=INFO
